        "sql",
        "orm",
        "telegram-bot",
        "typescript",
        "bot-framework"
    ],
    "author": {
        "name": "Maxim-M",
        "email": "maximco36895@yandex.ru",
        "url": "https://github.com/max36895"
    },
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "commonjs",
    "homepage": "https://github.com/max36895/umbot-knex-adapter#readme",
    "bugs": {
        "url": "https://github.com/max36895/umbot-knex-adapter/issues"
    },
    "repository": {
        "type": "git",
